# API base — empty in dev uses same-origin /api proxy; production same host or set URL
# Never put secrets here — only public URLs/hostnames (baked into build).
REACT_APP_API_URL=

# Optional: comma-separated extra hosts allowed for market images (CDN)
# REACT_APP_IMAGE_HOSTS=cdn.example.com

# Referral link hostname (default czutkabet.com)
# REACT_APP_REFERRAL_HOST=czutkabet.com
