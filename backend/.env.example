# Backend
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
NODE_ENV=development

# Set true behind nginx/Cloudflare so rate limits use real client IP (X-Forwarded-For / CF-Connecting-IP)
# TRUSTED_PROXY=true

# Dev-only: login as DEV_USERNAME without Discord/Telegram OTP (frontend shows when enabled)
DEV_LOGIN_CODE=dev-test-1234
DEV_USERNAME=devuser

# MongoDB — uses database "dev" or "prod" from NODE_ENV; optional MONGODB_DB override
DATABASE_URL=mongodb://localhost:27017

# Shared secret between backend and bots (HMAC-checked)
INTERNAL_SECRET=change-me-to-32-random-bytes-min

# Admin login — production: non-default ADMIN_LOGIN + Argon2 hashes (python scripts/hash_admin_credentials.py)
# ADMIN_LOGIN=
# ADMIN_PIN_HASH=
# ADMIN_PASSWORD_HASH=
# Development (plaintext; not allowed when NODE_ENV=production):
ADMIN_LOGIN=jrm8
ADMIN_PIN=9990
ADMIN_PASSWORD=8qq104

# Optional comma-separated extra hosts allowed for market image URLs (CDN)
# IMAGE_HOST_ALLOWLIST=cdn.example.com

# Odds-API.io — legacy auto-import (optional)
ODDS_API_KEY=

# iSports API — automatic bet import + auto-resolve
I_SPORTS_API_KEY=
# Bookmaker for auto-import odds: betclic (Betclic.pl), bet365, crown, ladbrokes, bwin, …
I_SPORTS_ODDS_BOOKMAKER=betclic

# BTC price source — leave Chainlink creds blank to fall back to Binance REST poll
CHAINLINK_API_KEY=
CHAINLINK_API_SECRET=
CHAINLINK_FEED_ID=0x00030ab7d02fbba9c6304f98824524407b1f494741174320cfd17a2c22eec1de
# Testnet: https://api.testnet-dataengine.chain.link — Mainnet: https://api.dataengine.chain.link
CHAINLINK_API_URL=https://api.testnet-dataengine.chain.link

# Bots → backend (must match INTERNAL_SECRET above)
BACKEND_URL=http://localhost:4000

# Telegram bot — token from @BotFather (also used by backend for BLIK DM notifications)
TELEGRAM_TOKEN=

# Discord bot — Developer Portal → Bot token + Application ID (also backend BLIK DMs)
DISCORD_TOKEN=
DISCORD_APP_ID=
# Channel IDs (Developer Mode → right-click channel → Copy Channel ID)
DISCORD_AUTH_CHANNEL_ID=
DISCORD_DAILY_CHANNEL_ID=
DISCORD_REWARDS_CHANNEL_ID=
DISCORD_DEPOSIT_WITHDRAW_CHANNEL_ID=
# PLN → crypto conversion (USD/PLN rate for quote display)
USD_PLN_RATE=4.0
# Legacy names (optional fallbacks if migrating an old .env)
# DISCORD_CHANNEL_ID=
# DISCORD_NICK_REWARD_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to run /auth /daily /rewards (empty = manage_guild only)
DISCORD_ADMIN_USER_IDS=

# --- Crypto payments (HD wallet, mainnet) ---
# BIP39 seed — never commit the real value; backup offline
PAYMENT_WALLET_MNEMONIC=
# Optional BIP39 passphrase (25th word) if you set one in Exodus
PAYMENT_WALLET_PASSPHRASE=
# Index-0 receive addresses (must match addresses derived from the mnemonic)
MASTER_BTC_ADDRESS=
MASTER_ETH_ADDRESS=
# USDC sweep targets (default to MASTER_ETH / MASTER_SOLANA when unset)
MASTER_USDC_ETH_ADDRESS=
MASTER_USDC_SOLANA_ADDRESS=
# Solana — off by default; set PAYMENTS_ENABLE_SOLANA=true when ready
MASTER_SOLANA_ADDRESS=
PAYMENTS_ENABLE_SOLANA=false
SOLANA_DERIVATION_PATH=
# Chain RPC (free tiers: Alchemy, Infura, Helius, QuickNode)
ETH_RPC_URL=https://ethereum.publicnode.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETHERSCAN_API_KEY=
USDC_ETH_CONTRACT=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
USDC_SOLANA_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PAYMENT_POLL_INTERVAL_SEC=15
PAYMENT_TIMEOUT_MIN=60
# After deposit confirmed, auto-send funds to MASTER_* addresses (needs gas on deposit addr for tokens)
PAYMENT_AUTO_SWEEP=true
# Sweep only when deposit address balance reaches these minimums (poll every SWEEP_POLL_INTERVAL_SEC)
SWEEP_MIN_SOL=0.0001
SWEEP_MIN_ETH=0.0005
SWEEP_MIN_BTC=0.00001
SWEEP_MIN_USDC=1
SWEEP_POLL_INTERVAL_SEC=120

# Discord daily code (auto-created at midnight Warsaw + /daily command)
DAILY_CODE_AMOUNT_PLN=10
DAILY_CODE_MAX_USES=500

# BLIK deposits — proof uploads + verification
BLIK_UPLOAD_DIR=data/blik_uploads
# false = accept valid file when OCR/PDF text unavailable (dev only)
BLIK_VERIFY_STRICT=true
