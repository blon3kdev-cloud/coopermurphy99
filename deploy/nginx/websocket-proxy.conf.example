# WebSocket support for /api/ (Crash game live feed).
# Include inside your `location /api/ { }` block (see deploytutorial.md step 7).
#
# Optional: put this map once in http { } (e.g. top of sites-available/kwk):
#   map $http_upgrade $connection_upgrade {
#       default upgrade;
#       ''      close;
#   }

proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
proxy_read_timeout 3600s;
proxy_send_timeout 3600s;
